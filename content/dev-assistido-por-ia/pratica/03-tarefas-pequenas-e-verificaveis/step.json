          "type": "note",
          "when": "=esc >= 3",
          "tone": "bad",
          "text": "@leakNote"
        },
        {
          "type": "note",
          "when": "=slices >= 8",
          "tone": "warn",
          "text": "@overNote"
        },
        {
          "type": "note",
          "when": "=esc < 3 && slices < 8",
          "tone": "=esc == 0 ? 'ok' : 'info'",
          "text": "@calmNote"
