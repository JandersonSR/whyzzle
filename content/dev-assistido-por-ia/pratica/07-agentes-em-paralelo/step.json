        "order": [
          "cupom",
          "agenda",
          "relatorio",
          "frete"
        ],
        "rebase": 15
      },
      "compute": {
        "mask": "memberall(order, tasks)",
        "nT": "sum(mask)",
        "rk": "join(mask, '')",
        "r": "lookup(runs, rk, runs['1110'])",
        "shared": "iso == 'folder' && nT >= 2",
        "red": "shared ? nT * (nT - 1) : 0",
        "wallMin": "review ? r.wall : r.wallNoReview",
        "nConf": "iso == 'worktree' ? r.conflicts : 0",
        "tableRows": "r.rows"
      },
      "cases": [
        {
          "when": "nT == 0",
          "error": "noTasks"
        },
        {
          "when": "shared",
          "flags": [
            "clobbered"
          ]
        },
        {
          "when": "iso == 'worktree' && r.conflicts > 0",
          "flags": [
            "conflict"
          ]
        },
        {
          "when": "!review",
          "flags": [
            "unreviewed"
          ]
        },
        {
          "when": "review && r.reviewSum > r.agentMax",
          "flags": [
            "reviewBound"
          ]
        },
        {
          "when": "true",
          "vars": {
            "n": "nT",
            "red": "red",
            "wall": "wallMin",
            "seq": "r.seq",
            "agentMax": "r.agentMax",
            "reviewSum": "r.reviewSum",
            "conflicts": "nConf",
            "conflictFile": "r.conflictFile",
            "rebase": "rebase"
          }
        }
      ],
      "widgets": [
        {
          "type": "metrics",
          "items": [
            {
              "label": "@mAgents",
              "value": "=r.agentMax",
              "format": "min",
              "tone": "info"
            },
            {
              "label": "@mReview",
              "value": "=review ? r.reviewSum : 0",
              "format": "min",
              "tone": "=review ? (r.reviewSum > r.agentMax ? 'warn' : 'ok') : 'bad'"
            },
            {
              "label": "@mWall",
              "value": "=wallMin",
              "format": "min",
              "tone": "=shared ? 'bad' : 'ok'"
            },
            {
              "label": "@mSeq",
              "value": "=r.seq",
              "format": "min",
              "tone": "dim"
            },
            {
              "label": "@mConf",
              "value": "=nConf",
              "format": "int",
              "tone": "=nConf > 0 ? 'warn' : 'ok'"
            }
          ]
        },
        {
          "type": "table",
          "label": "@table",
          "columns": [
            "@colTask",
            "@colFiles",
            "@colAgent",
            "@colDone"
          ],
          "rows": "=tableRows",
          "caption": "=review ? '@capReview' : '@capNoReview'"
        },
        {
          "type": "terminal",
          "label": "@term",
          "lines": "=shared ? termShared : (nConf > 0 ? termConflict : termOk)"
        },
        {
          "type": "note",
          "when": "=shared",
          "tone": "bad",
          "text": "@sharedNote"
        },
        {
          "type": "note",
          "when": "=!shared && nConf > 0",
          "tone": "warn",
          "text": "@conflictNote"
        },
        {
          "type": "note",
          "when": "=!review",
          "tone": "bad",
          "text": "@noReviewNote"
        },
        {
          "type": "note",
          "when": "=!shared && review && r.reviewSum > r.agentMax",
          "tone": "info",
          "text": "@boundNote"
        }
      ]
    }
  },
  "predict": {
    "options": [
