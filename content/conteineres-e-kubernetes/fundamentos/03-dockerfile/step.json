      "compute": {
        "b": "lookup(builds, order + '-' + changed + '-' + (ignore ? 'y' : 'n'), null)",
        "secs": "b.secs",
        "reran": "b.reran",
        "ctxMB": "b.ctx",
        "buildLines": "concat(['$ docker build -t ' + text + ' .'], b.lines)",
        "busted": "order == 'copyAll' && changed == 'code'"
      },
      "cases": [
        {
          "when": "busted",
          "flags": [
            "cacheBusted"
          ]
        },
        {
          "when": "!ignore",
          "flags": [
            "fatContext"
          ]
        },
        {
          "when": "true",
          "vars": {
            "secs": "round(secs)",
            "reran": "reran",
            "ctxMB": "ctxMB"
          }
        }
      ],
      "widgets": [
        {
          "type": "metrics",
          "items": [
            {
              "label": "@secsM",
              "value": "=secs",
              "tone": "=secs > 30 ? 'bad' : 'ok'"
            },
            {
              "label": "@reranM",
              "value": "=reran",
              "format": "int",
              "tone": "=busted ? 'bad' : 'info'"
            },
            {
              "label": "@ctxM",
              "value": "=ctxMB",
              "format": "int",
              "tone": "=ignore ? 'ok' : 'warn'"
            }
          ]
        },
        {
          "type": "table",
          "label": "@tableLabel",
          "columns": [
            "#",
            "@colInstr",
            "@colStatus",
            "@colTime"
          ],
          "rows": "=b.rows",
          "tones": "=b.tones",
          "caption": "@tableCap"
        },
        {
          "type": "terminal",
          "label": "@termLabel",
          "lines": "=buildLines"
        },
        {
          "type": "note",
          "when": "=busted",
          "tone": "bad",
          "text": "@bustNote"
        },
        {
          "type": "note",
          "when": "=!ignore && order == 'depsFirst'",
          "tone": "warn",
          "text": "@ctxNote"
        },
        {
          "type": "note",
          "when": "=!ignore && order == 'copyAll'",
          "tone": "warn",
          "text": "@ctxNoteAll"
        },
        {
          "type": "note",
          "when": "=!busted && ignore && changed == 'deps'",
          "tone": "info",
          "text": "@depsNote"
        },
        {
          "type": "note",
          "when": "=!busted && ignore && changed != 'deps'",
          "tone": "ok",
          "text": "@okNote"
        }
      ]
    }
  },
  "predict": {
    "options": [
      "full",
      "fast",
      "zero"
    ],
    "answer": "fast"
  }
}
