      },
      "compute": {
        "isProc": "isolation == 'process'",
        "isVm": "isolation == 'vm'",
        "ovh": "lookup(overheadMB, isolation, 0)",
        "perApp": "appMB + ovh",
        "maxApps": "floor((hostMB - hostOsMB) / perApp)",
        "fits": "apps <= maxApps",
        "upApps": "min(apps, maxApps)",
        "kernels": "isVm ? upApps : 1",
        "usedMB": "hostOsMB + upApps * perApp",
        "startS": "lookup(startSec, isolation, 0)",
        "clash": "isProc && apps >= 2",
        "brokenApps": "clash ? floor((apps + 1) / 3) : 0",
        "running": "upApps - brokenApps",
        "pods": "slice(concat(slice(clash ? podsClash : podsOk, 0, upApps), slice(podsWait, upApps, apps)), 0, 12)"
      },
      "cases": [
        {
          "when": "clash",
          "flags": [
            "versionClash"
          ]
        },
        {
          "when": "!fits",
          "flags": [
            "noRoom"
          ]
        },
        {
          "when": "true",
          "vars": {
            "kernels": "kernels",
            "usedMB": "usedMB",
            "brokenApps": "brokenApps",
            "maxApps": "maxApps",
            "running": "running"
          }
        }
      ],
      "widgets": [
        {
          "type": "metrics",
          "items": [
            {
              "label": "@kernelsM",
              "value": "=kernels",
              "format": "int",
              "tone": "=isVm ? 'warn' : 'ok'"
            },
            {
              "label": "@ramM",
              "value": "=usedMB",
              "format": "int",
              "tone": "=fits ? 'ok' : 'bad'"
            },
            {
              "label": "@bootM",
              "value": "=startS",
              "tone": "=isVm ? 'warn' : 'ok'"
            },
            {
              "label": "@brokenM",
              "value": "=brokenApps",
              "format": "int",
              "tone": "=brokenApps > 0 ? 'bad' : 'dim'"
            }
          ]
        },
        {
          "type": "cluster",
          "label": "@clusterLabel",
          "nodes": [
            {
              "name": "=text",
              "status": "=isVm ? '@stVm' : (isProc ? '@stProc' : '@stCtr')",
              "tone": "=fits ? (clash ? 'warn' : 'ok') : 'bad'",
              "pods": "=pods"
            }
          ]
        },
        {
          "type": "terminal",
          "when": "=isProc",
          "label": "@termProc",
          "lines": [
            "$ node -p \"process.versions.node.split('.')[0]\"",
            "24",
            "=clash ? '@clashLine' : '@soloLine'"
          ]
        },
        {
          "type": "terminal",
          "when": "=isolation == 'container'",
          "label": "@termCtr",
          "lines": [
            "$ docker run --rm node:18-alpine node -p \"process.versions.node.split('.')[0]\"",
            "18",
            "$ docker run --rm node:24-alpine node -p \"process.versions.node.split('.')[0]\"",
            "24"
          ]
        },
        {
          "type": "terminal",
          "when": "=isVm",
          "label": "@termVm",
          "lines": [
            "@vmLine1",
            "@vmLine2"
          ]
        },
        {
          "type": "table",
          "label": "@tableLabel",
          "columns": [
            "@colAspect",
            "@colProc",
            "@colCtr",
            "@colVm"
          ],
          "rows": [
            [
              "@rKernel",
              "@no",
              "@no",
              "@yes"
            ],
            [
              "@rFiles",
              "@no",
              "@yes",
              "@yes"
            ],
            [
              "@rBoot",
              "@bootProc",
              "@bootCtr",
              "@bootVm"
            ],
            [
              "@rRam",
              "0 MB",
              "10 MB",
              "@ramVm"
            ]
          ],
          "caption": "@tableCap"
        },
        {
          "type": "note",
          "when": "=clash",
          "tone": "bad",
          "text": "@clashNote"
        },
        {
          "type": "note",
          "when": "=!fits",
          "tone": "bad",
          "text": "@roomNote"
        },
        {
          "type": "note",
          "when": "=isolation == 'container'",
          "tone": "ok",
          "text": "@ctrNote"
        },
        {
          "type": "note",
          "when": "=isVm && fits",
          "tone": "info",
          "text": "@vmNote"
        }
      ]
    }
  },
  "predict": {
    "options": [
      "ownKernel",
      "sharedKernel",
      "noIsolation"
    ],
    "answer": "sharedKernel"
  }
}
