{
  "id": "k8s-registro",
  "order": 4,
  "track": "fundamentos",
  "kind": "step",
  "minutes": 15,
  "tags": [
    "registro",
    "tag",
    "digest",
    "docker-hub",
    "ghcr",
    "acr"
  ],
  "requires": [
    "k8s-dockerfile"
  ],
  "executors": [
    "simulado"
  ],
  "model": "declarative",
  "scene": "widgets",
  "command": {
    "verb": {
      "pt": "implantar",
      "en": "deploy"
    },
    "arg": {
      "name": "text",
      "required": false,
      "default": {
        "pt": "api-pedidos",
        "en": "api-pedidos"
      },
      "ui": "text"
    },
    "flags": [
      {
        "name": "ref",
        "alias": {
          "pt": "referencia",
          "en": "ref"
        },
        "type": "enum",
        "options": [
          {
            "id": "version",
            "pt": "versao",
            "en": "version"
          },
          {
            "id": "latest",
            "pt": "latest",
            "en": "latest"
          },
          {
            "id": "digest",
            "pt": "digest",
            "en": "digest"
          }
        ],
        "default": "version",
        "ui": "select"
      },
      {
        "name": "registry",
        "alias": {
          "pt": "registro",
          "en": "registry"
        },
        "type": "enum",
        "options": [
          {
            "id": "ghcr",
            "pt": "ghcr",
            "en": "ghcr"
          },
          {
            "id": "hub",
            "pt": "dockerhub",
            "en": "dockerhub"
          },
          {
            "id": "acr",
            "pt": "acr",
            "en": "acr"
          },
          {
            "id": "local",
            "pt": "local",
            "en": "local"
          }
        ],
        "default": "ghcr",
        "ui": "select"
      },
      {
        "name": "overwrite",
        "alias": {
          "pt": "sobrescreveu",
          "en": "overwritten"
        },
        "type": "bool",
        "default": false,
        "ui": "switch"
      }
    ]
  },
  "break": {
    "flag": "drift"
  },
  "data": {
    "sim": {
      "live": true,
      "consts": {
        "prefixes": {
          "ghcr": "ghcr.io/escola/",
          "hub": "docker.io/escola/",
          "acr": "escola.azurecr.io/",
          "local": "localhost:5000/"
        },
        "digests": {
          "A": "ea47e5527bcfce19eced0ff2251694500a4cc93be2c4b3fbf92e020361e21ba7",
          "B": "d0584e8333f87d6c6459dda918183a8faaf670ee2aea6862d06dc4e059b4f281",
          "C": "3a38c2084c9a7e37509eea8e1c7e14b895b97cbefb7476a2295c8a0ef7183c71"
        },
        "short": {
          "A": "ea47e5527bcf",
          "B": "d0584e8333f8",
          "C": "3a38c2084c9a"
        }
      },
      "compute": {
        "pfx": "lookup(prefixes, registry, '')",
        "refPart": "ref == 'latest' ? ':latest' : (ref == 'version' ? ':1.4' : '@sha256:' + digests.A)",
        "fullRef": "pfx + text + refPart",
        "bKey": "ref == 'latest' ? 'C' : (ref == 'version' ? (overwrite ? 'B' : 'A') : 'A')",
        "drifted": "bKey != 'A'",
        "aVer": "lookup(verNames, 'A', '')",
        "bVer": "lookup(verNames, bKey, '')",
        "sA": "short.A",
        "sC": "short.C",
        "bShort": "lookup(short, bKey, '')",
        "tag14": "overwrite ? short.B : short.A",
        "loginLine": "'$ ' + lookup(logins, registry, '')",
        "timeline": "[['@mon', '@evMon', sA, sA, '—'], ['@tue', overwrite ? '@evTueOver' : '@evTue', sC, tag14, sC]]"
      },
      "cases": [
        {
          "when": "drifted",
          "flags": [
            "drift"
          ]
        },
        {
          "when": "ref == 'latest'",
          "flags": [
            "floatingTag"
          ]
        },
        {
          "when": "ref == 'digest'",
          "flags": [
            "pinned"
          ]
        },
        {
          "when": "true",
          "vars": {
            "a": "aVer",
            "b": "bVer",
            "fullRef": "fullRef"
          }
        }
      ],
      "widgets": [
        {
          "type": "metrics",
          "items": [
            {
              "label": "@aM",
              "value": "=aVer",
              "tone": "info"
            },
            {
              "label": "@bM",
              "value": "=bVer",
              "tone": "=drifted ? 'bad' : 'ok'"
            },
            {
              "label": "@sameM",
              "value": "=drifted ? '@no' : '@yes'",
              "tone": "=drifted ? 'bad' : 'ok'"
            }
          ]
        },
        {
          "type": "cluster",
          "label": "@clusterLabel",
          "nodes": [
            {
              "name": "@srvA",
              "status": "@pulledMon",
              "tone": "ok",
              "pods": [
                {
                  "name": "='api-pedidos · ' + sA",
                  "status": "Running"
                }
              ]
            },
            {
              "name": "@srvB",
              "status": "@pulledWed",
              "tone": "=drifted ? 'warn' : 'ok'",
              "pods": [
                {
                  "name": "='api-pedidos · ' + bShort",
                  "status": "Running"
                }
              ]
            }
          ]
        },
        {
          "type": "table",
          "label": "@tableLabel",
          "columns": [
            "@colWhen",
            "@colEvent",
            "latest",
            "1.4",
            "1.5"
          ],
          "rows": "=timeline",
          "tones": "=['neutral', overwrite ? 'warn' : 'neutral']",
          "caption": "@tableCap"
        },
        {
          "type": "terminal",
          "label": "@termLabel",
          "lines": [
            "=loginLine",
            "='$ docker pull ' + fullRef",
            "=(drifted ? '?' : '+') + 'Digest: sha256:' + lookup(digests, bKey, '')",
            "='Status: Downloaded newer image for ' + fullRef"
          ]
        },
        {
          "type": "note",
          "when": "=drifted && ref == 'latest'",
          "tone": "bad",
          "text": "@driftLatest"
        },
        {
          "type": "note",
          "when": "=drifted && ref == 'version'",
          "tone": "bad",
          "text": "@driftOver"
        },
        {
          "type": "note",
          "when": "=ref == 'digest'",
          "tone": "ok",
          "text": "@pinNote"
        },
        {
          "type": "note",
          "when": "=ref == 'version' && !overwrite",
          "tone": "info",
          "text": "@versionNote"
        }
      ]
    }
  },
  "predict": {
    "options": [
      "v14",
      "v15",
      "error"
    ],
    "answer": "v14"
  }
}
