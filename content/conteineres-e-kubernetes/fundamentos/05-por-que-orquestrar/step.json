      "compute": {
        "sc": "lookup(scenarios, way + '-' + event + '-' + servers, null)",
        "downMin": "sc.down",
        "humansN": "sc.humans",
        "autoN": "sc.auto",
        "readyN": "sc.ready",
        "needN": "sc.need",
        "cmdsN": "sc.cmds",
        "atTime": "sc.time",
        "causeText": "lookup(causes, sc.cause, '')",
        "flowSteps": "lookup(flows, sc.flow, [])",
        "isOrch": "way == 'orchestrator'"
      },
      "cases": [
        {
          "when": "humansN > 0",
          "flags": [
            "humanNeeded"
          ]
        },
        {
          "when": "humansN == 0",
          "flags": [
            "selfHealed"
          ]
        },
        {
          "when": "true",
          "vars": {
            "downMin": "downMin",
            "humansN": "humansN",
            "autoN": "autoN",
            "readyN": "readyN",
            "needN": "needN",
            "atTime": "atTime",
            "causeText": "causeText"
          }
        }
      ],
      "widgets": [
        {
          "type": "metrics",
          "items": [
            {
              "label": "@readyM",
              "value": "=readyN + ' / ' + needN",
              "tone": "=readyN < needN ? 'warn' : 'ok'"
            },
            {
              "label": "@downM",
              "value": "=downMin",
              "format": "min",
              "tone": "=downMin > 10 ? 'bad' : (downMin > 0 ? 'warn' : 'ok')"
            },
            {
              "label": "@humansM",
              "value": "=humansN",
              "format": "int",
              "tone": "=humansN > 0 ? 'bad' : 'ok'"
            },
            {
              "label": "@cmdsM",
              "value": "=cmdsN",
              "format": "int",
              "tone": "=cmdsN > 0 ? 'warn' : 'dim'"
            }
          ]
        },
        {
          "type": "cluster",
          "label": "@clusterLabel",
          "nodes": "=sc.nodes"
        },
        {
          "type": "flow",
          "label": "@flowLabel",
          "steps": "=flowSteps"
        },
        {
          "type": "note",
          "when": "=humansN > 0",
          "tone": "bad",
          "text": "@humanNote"
        },
        {
          "type": "note",
          "when": "=humansN == 0",
          "tone": "ok",
          "text": "@healNote"
        }
      ]
    }
  },
  "predict": {
    "options": [
      "rescheduled",
      "waits",
      "gone"
    ],
    "answer": "rescheduled"
  }
}
