      "widgets": [
        {
          "type": "flow",
          "label": "@pipeline",
          "steps": [
            {
              "label": "@sIngest",
              "sub": "=clean ? '@subClean' : '@subDirty'",
              "tone": "=clean ? 'ok' : 'warn'"
            },
            {
              "label": "@sSearch",
              "sub": "=mode == 'keyword' ? '@subKeyword' : (mode == 'vector' ? '@subVector' : '@subHybrid')",
              "tone": "=mode == 'hybrid' ? 'ok' : 'warn'"
            },
            {
              "label": "@sGate",
              "sub": "=limit > 0 ? limitPct + '%' : '@subNoGate'",
              "tone": "=limit > 0 ? 'ok' : 'warn'"
            },
            {
              "label": "@sAnswer",
              "sub": "=cite ? (refuse ? '@subCiteRefuse' : '@subCite') : (refuse ? '@subNoCiteRefuse' : '@subNoCite')",
              "tone": "=cite && refuse ? 'ok' : 'warn'"
            },
            {
              "label": "@sTriage",
              "sub": "=triage ? '@subTriageOn' : '@subTriageOff'",
              "tone": "=triage ? 'ok' : 'warn'"
            }
          ]
        },
        {
          "type": "checks",
          "label": "@checks",
          "items": [
            {
              "label": "@cRecall",
              "ok": "=okRecall",
              "why": "@cRecallWhy"
            },
            {
              "label": "@cAnswers",
              "ok": "=okAnswers",
              "why": "=!clean ? '@cAnswersWhyDirty' : (nFalseRef > 0 ? '@cAnswersWhyRef' : '@cAnswersWhyRet')"
            },
            {
              "label": "@cCite",
              "ok": "=okCite",
              "why": "=cite ? '@cCiteWhyBad' : '@cCiteWhyOff'"
            },
            {
              "label": "@cRefuse",
              "ok": "=okRefuse",
              "why": "=!refuse ? '@cRefuseWhyOff' : (nFalseRef > 0 ? '@cRefuseWhyHigh' : '@cRefuseWhyLow')"
            },
            {
              "label": "@cTriage",
              "ok": "=okTriage",
              "why": "@cTriageWhy"
            },
            {
              "label": "@cClean",
              "ok": "=okClean",
              "why": "@cCleanWhy"
            }
          ]
        },
        {
          "type": "metrics",
          "items": [
            {
              "label": "@mRecall",
              "value": "=recPct",
              "format": "pct",
              "tone": "=okRecall ? 'ok' : 'bad'"
            },
            {
              "label": "@mAnswers",
              "value": "=nCorrect + ' / ' + nAns",
              "tone": "=okAnswers ? 'ok' : 'bad'"
            },
            {
              "label": "@mRefusals",
              "value": "=nOutRef + ' / ' + nOut",
              "tone": "=nOutRef == nOut ? 'ok' : 'bad'"
            },
            {
              "label": "@mRouted",
              "value": "=nRouted + ' / ' + nSens",
              "tone": "=okTriage ? 'ok' : 'bad'"
            }
          ]
        },
        {
          "type": "table",
          "label": "@table",
          "columns": [
            "@colRes",
            "@colQ",
            "@colConf",
            "@colExp"
          ],
          "rows": "=zip([x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, x12], qShort, confLabels, expKeys)",
          "tones": "=[g0 == 1 ? 'ok' : 'bad', g1 == 1 ? 'ok' : 'bad', g2 == 1 ? 'ok' : 'bad', g3 == 1 ? 'ok' : 'bad', g4 == 1 ? 'ok' : 'bad', g5 == 1 ? 'ok' : 'bad', g6 == 1 ? 'ok' : 'bad', g7 == 1 ? 'ok' : 'bad', g8 == 1 ? 'ok' : 'bad', g9 == 1 ? 'ok' : 'bad', g10 == 1 ? 'ok' : 'bad', g11 == 1 ? 'ok' : 'bad', g12 == 1 ? 'ok' : 'bad']",
          "caption": "@tableCaption"
        },
        {
          "type": "note",
          "when": "=real",
          "tone": "info",
          "text": "@realNote"
        },
        {
          "type": "note",
          "when": "=!real",
          "tone": "info",
          "text": "@simNote"
        }
      ]
    }
