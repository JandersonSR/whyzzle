        "x8": "r8 ? '@xAnsRefused' : (recK[8] == 1 ? '@xAnsOk' : '@xAnsWrong')",
        "t9": "false",
        "r9": "!t9 && refuse && confs[9] < limit",
        "g9": "r9 ? 1 : 0",
        "x9": "r9 ? '@xOutRefused' : '@xOutInvented'",
        "t10": "false",
        "r10": "!t10 && refuse && confs[10] < limit",
        "g10": "r10 ? 1 : 0",
        "x10": "r10 ? '@xOutRefused' : '@xOutInvented'",
        "t11": "triage",
        "r11": "!t11 && refuse && confs[11] < limit",
        "g11": "t11 ? 1 : 0",
        "x11": "t11 ? '@xSensRouted' : (r11 ? '@xSensRefused' : '@xSensAnswered')",
        "t12": "triage",
        "r12": "!t12 && refuse && confs[12] < limit",
        "g12": "t12 ? 1 : 0",
        "x12": "t12 ? '@xSensRouted' : (r12 ? '@xSensRefused' : '@xSensAnswered')",
        "meanRec": "sum(mul(recK, ansMask)) / nAns",
        "nCorrect": "g0 + g1 + g2 + g3 + g4 + g5 + g6 + g7 + g8",
        "nOutRef": "g9 + g10",
        "nRouted": "g11 + g12",
        "nFalseRef": "w0 + w1 + w2 + w3 + w4 + w5 + w6 + w7 + w8",
        "nCiteBad": "cb0 + cb1 + cb2 + cb3 + cb4 + cb5 + cb6 + cb7 + cb8",
        "okRecall": "meanRec >= needRecall",
        "okAnswers": "nCorrect == nAns",
        "okCite": "cite && nCiteBad == 0",
        "okRefuse": "nOutRef == nOut && nFalseRef == 0",
        "okTriage": "nRouted == nSens",
        "okClean": "clean",
        "okCount": "(okRecall ? 1 : 0) + (okAnswers ? 1 : 0) + (okCite ? 1 : 0) + (okRefuse ? 1 : 0) + (okTriage ? 1 : 0) + (okClean ? 1 : 0)",
        "allOk": "okCount == 6",
        "recPct": "round(meanRec * 100)",
