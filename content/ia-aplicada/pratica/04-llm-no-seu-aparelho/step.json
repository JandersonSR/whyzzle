{
  "id": "p-llm-no-seu-aparelho",
  "order": 4,
  "track": "pratica",
  "minutes": 15,
  "tags": [
    "llm-local",
    "temperatura",
    "top-p",
    "max-tokens",
    "webllm"
  ],
  "requires": [
    "p-tokens-de-verdade",
    "temperatura"
  ],
  "executors": [
    "simulado",
    "no-navegador",
    "sua-chave"
  ],
  "model": "declarative",
  "scene": "widgets",
  "command": {
    "verb": {
      "pt": "gerar",
      "en": "generate"
    },
    "arg": {
      "name": "text",
      "required": true,
      "ui": "examples",
      "default": {
        "pt": "Crie um slogan curto para uma padaria de bairro",
        "en": "Write a short slogan for a neighborhood bakery"
      },
      "examples": [
        {
          "pt": "Crie um slogan curto para uma padaria de bairro",
          "en": "Write a short slogan for a neighborhood bakery"
        },
        {
          "pt": "Explique em uma frase o que é inflação",
          "en": "Explain inflation in one sentence"
        }
      ]
    },
    "flags": [
      {
        "name": "temp",
        "alias": {
          "pt": "temp",
          "en": "temp"
        },
        "type": "number",
        "min": 0,
        "max": 2,
        "step": 0.1,
        "default": 0.7,
        "ui": "slider"
      },
      {
        "name": "topP",
        "alias": {
          "pt": "top-p",
          "en": "top-p"
        },
        "type": "number",
        "min": 0.05,
        "max": 1,
        "step": 0.05,
        "default": 1,
        "ui": "slider"
      },
      {
        "name": "maxTokens",
        "alias": {
          "pt": "max",
          "en": "max"
        },
        "type": "int",
        "min": 1,
        "max": 400,
        "uiMax": 150,
        "default": 60,
        "ui": "slider"
      },
      {
        "name": "samples",
        "alias": {
          "pt": "amostras",
          "en": "samples"
        },
        "type": "int",
        "min": 1,
        "max": 5,
        "default": 3,
        "ui": "slider"
      }
    ]
  },
  "predict": {
    "options": [
      "one",
      "three",
      "depends"
    ],
    "answer": "one"
  },
  "break": {
    "flag": "truncated"
  },
  "data": {
    "sim": {
      "live": false,
      "consts": {
        "real": false,
        "realOutputs": [],
        "realOutput": "",
        "realDistinct": 0
      },
      "compute": {
        "pool": "temp == 0 ? 1 : clamp(round(1 + temp * topP * 3), 1, 6)",
        "simOutputs": "truncwords(sample(canned, samples, pool), floor(maxTokens / 1.4))",
        "outputs": "real ? realOutputs : simOutputs",
        "distinct": "real ? realDistinct : len(unique(outputs))",
        "cut": "real ? (maxTokens <= 20 && !endsany(realOutput, ['.', '!', '?', '\"', '”'])) : endsany(outputs[0], ['…'])"
      },
      "cases": [
        {
          "when": "cut",
          "flags": [
            "truncated"
          ]
        },
        {
          "when": "distinct > 1",
          "flags": [
            "varied"
          ]
        },
        {
          "when": "true",
          "vars": {
            "distinct": "distinct",
            "n": "samples",
            "maxTokens": "maxTokens"
          }
        }
      ],
      "widgets": [
        {
          "type": "metrics",
          "items": [
            {
              "label": "@distinct",
              "value": "=distinct",
              "format": "int",
              "tone": "=distinct > 1 ? 'info' : 'ok'"
            },
            {
              "label": "@samples",
              "value": "=samples",
              "format": "int",
              "tone": "dim"
            },
            {
              "label": "@max",
              "value": "=maxTokens",
              "format": "int",
              "tone": "=cut ? 'bad' : 'neutral'"
            }
          ]
        },
        {
          "type": "terminal",
          "label": "@outputs",
          "lines": "=concat(['$ ' + text], outputs)"
        },
        {
          "type": "note",
          "when": "=temp == 0",
          "tone": "info",
          "text": "@greedyNote"
        },
        {
          "type": "note",
          "when": "=cut",
          "tone": "warn",
          "text": "@cutNote"
        },
        {
          "type": "note",
          "when": "=!real",
          "tone": "info",
          "text": "@simNote"
        }
      ]
    }
  },
  "real": {
    "no-navegador": {
      "adapter": "declarative",
      "model": "Llama-3.2-1B-Instruct-q4f16_1-MLC",
      "op": "chat",
      "args": {
        "system": "{sysText}",
        "user": "{text}"
      }
    },
    "sua-chave": {
      "adapter": "declarative",
      "op": "chat",
      "args": {
        "system": "{sysText}",
        "user": "{text}"
      }
    }
  }
}
