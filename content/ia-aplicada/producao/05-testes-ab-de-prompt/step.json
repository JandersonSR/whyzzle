      "compute": {
        "stopDay": "peek && firstSig <= days ? firstSig : days",
        "i": "stopDay - 1",
        "sig": "sigArr[i]",
        "early": "stopDay < minDays",
        "liftS": "liftStr[i]",
        "pS": "pStr[i]",
        "nS": "nStr[i]",
        "rateA": "round(sA[i] / nArr[i] * 100)",
        "rateB": "round(sB[i] / nArr[i] * 100)",
        "trueLiftS": "liftStr[refDay - 1]"
      },
      "cases": [
        {
          "when": "peek && firstSig <= days && firstSig < minDays",
          "flags": [
            "peeked"
          ]
        },
        {
          "when": "sig",
          "flags": [
            "significant"
          ]
        },
        {
          "when": "!sig",
          "flags": [
            "inconclusive"
          ]
        },
        {
          "when": "!peek && days < minDays",
          "flags": [
            "underpowered"
          ]
        },
        {
          "when": "true",
          "vars": {
            "stopDay": "stopDay",
            "liftS": "liftS",
            "pS": "pS",
            "nS": "nS",
            "trueLiftS": "trueLiftS",
            "minDays": "minDays",
            "refDay": "refDay",
            "rateA": "rateA",
            "rateB": "rateB",
            "days": "days"
          }
        }
      ],
      "widgets": [
        {
          "type": "metrics",
          "items": [
            {
              "label": "@mDay",
              "value": "=stopDay",
              "format": "int",
              "tone": "=early ? 'warn' : 'ok'"
            },
            {
              "label": "@mA",
              "value": "=rateA",
              "format": "pct",
              "tone": "neutral"
            },
            {
              "label": "@mB",
              "value": "=rateB",
              "format": "pct",
              "tone": "neutral"
            },
            {
              "label": "@mLift",
              "value": "=liftS",
              "tone": "=sig ? 'ok' : 'warn'"
            },
            {
              "label": "@mP",
              "value": "=pS",
              "tone": "=sig ? 'ok' : 'warn'"
            }
          ]
        },
        {
          "type": "chart",
          "label": "@chart",
          "kind": "line",
          "labels": "=slice(dayLabels, 0, stopDay)",
          "series": [
            {
              "label": "@zSeries",
              "values": "=slice(zArr, 0, stopDay)"
            }
          ],
          "threshold": {
            "value": 1.96,
            "label": "@zLine"
          }
        },
        {
          "type": "checks",
          "label": "@checks",
          "items": [
            {
              "label": "@chkSize",
              "ok": "=!early",
              "why": "@whySize"
            },
            {
              "label": "@chkSig",
              "ok": "=sig",
              "why": "@whySig"
            },
            {
              "label": "@chkPlan",
              "ok": "=!(peek && firstSig <= days)",
              "why": "@whyPlan"
            }
          ]
        },
        {
          "type": "note",
          "when": "=peek && firstSig <= days && early",
          "tone": "bad",
          "text": "@peekNote"
        },
        {
          "type": "note",
          "when": "=!peek && early",
          "tone": "warn",
          "text": "@smallNote"
        },
        {
          "type": "note",
          "when": "=!early && sig",
          "tone": "ok",
          "text": "@okNote"
        },
        {
          "type": "note",
          "tone": "info",
          "text": "@simNote"
        }
      ]
    }
  },
  "predict": {
    "options": [
      "holds",
      "shrinks",
      "flips"
    ],
    "answer": "shrinks"
  }
