          ],
          "12": [
            12,
            12,
            0,
            0
          ]
        },
        "limit": 3
      },
      "compute": {
        "pk": "prefetch == 0 || prefetch > 12 ? '0' : str(prefetch)",
        "row": "lookup(sac ? sacTab : rrTab, pk, [0, 0, 0, 0])",
        "finishMin": "row[0]",
        "fastN": "row[1]",
        "slowN": "row[2]",
        "oooN": "row[3]",
        "triesText": "dlq ? str(limit) : '∞'"
      },
      "cases": [
        {
          "when": "!dlq",
          "flags": [
            "poisonLoop"
          ]
        },
        {
          "when": "dlq",
          "flags": [
            "parked"
          ]
        },
        {
          "when": "oooN > 0",
          "flags": [
            "outOfOrder"
          ]
        },
        {
          "when": "!sac && slowN >= fastN",
          "flags": [
            "hoarding"
          ]
        },
        {
          "when": "true",
          "vars": {
            "finish": "finishMin",
            "fast": "fastN",
            "slow": "slowN",
            "ooo": "oooN",
            "p": "prefetch"
          }
        }
      ],
      "widgets": [
        {
          "type": "metrics",
          "items": [
            {
              "label": "@finishM",
              "value": "=finishMin",
              "format": "min",
              "tone": "=finishMin > 12 ? 'warn' : 'ok'"
            },
            {
              "label": "@oooM",
              "value": "=oooN",
              "format": "int",
              "tone": "=oooN > 0 ? 'warn' : 'ok'"
            },
            {
              "label": "@triesM",
              "value": "=triesText",
              "tone": "=dlq ? 'ok' : 'bad'"
            }
          ]
        },
        {
          "type": "queue",
          "label": "@queueLabel",
          "producer": "@counter",
          "empty": "@emptyQueue",
          "messages": "=dlq ? [] : ['!☠ #13']",
          "consumers": [
            {
              "label": "@fastW",
              "note": "@fastNote",
              "tone": "=dlq ? 'ok' : 'bad'"
            },
            {
              "label": "@slowW",
              "note": "=sac ? '@standby' : '@slowNote'",
              "tone": "=sac ? 'dim' : 'ok'"
            }
          ],
          "dlq": "=dlq ? ['☠ #13'] : []",
          "dlqLabel": "DLQ"
        },
        {
          "type": "chart",
          "label": "@chart",
          "kind": "bar",
          "labels": [
            "@fastW",
            "@slowW"
          ],
          "series": [
            {
              "label": "@ordersS",
              "values": "=[fastN, slowN]"
            }
          ]
        },
        {
          "type": "terminal",
          "label": "@terminal",
          "lines": "=dlq ? ['@t1', '@t2', '@t3', '@tDlq'] : ['@t1', '@t2', '@t3', '@tLoop1', '@tLoop2']"
        },
        {
          "type": "note",
          "when": "=!dlq",
          "tone": "bad",
          "text": "@loopNote"
        },
        {
          "type": "note",
          "when": "=!sac && slowN >= fastN",
          "tone": "warn",
          "text": "@hoardNote"
        },
        {
          "type": "note",
          "when": "=oooN > 0",
          "tone": "info",
          "text": "@oooNote"
        }
      ]
    }
  },
  "predict": {
    "options": [
      "faster",
      "same",
      "slower"
    ],
    "answer": "slower"
  }
}
