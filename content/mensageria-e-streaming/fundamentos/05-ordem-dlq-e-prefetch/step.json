{
  "id": "msg-ordem-dlq-prefetch",
  "order": 5,
  "track": "fundamentos",
  "kind": "step",
  "minutes": 20,
  "tags": [
    "mensageria",
    "prefetch",
    "dlq",
    "ordem",
    "rabbitmq"
  ],
  "requires": [
    "msg-ack-e-garantias"
  ],
  "executors": [
    "simulado"
  ],
  "model": "declarative",
  "scene": "widgets",
  "command": {
    "verb": {
      "pt": "distribuir",
      "en": "dispatch"
    },
    "arg": {
      "name": "text",
      "required": false,
      "default": {
        "pt": "pedidos",
        "en": "pedidos"
      },
      "ui": "text"
    },
    "flags": [
      {
        "name": "prefetch",
        "alias": {
          "pt": "prefetch",
          "en": "prefetch"
        },
        "type": "int",
        "min": 0,
        "max": 1000,
        "uiMax": 12,
        "default": 1,
        "ui": "slider"
      },
      {
        "name": "dlq",
        "alias": {
          "pt": "dlq",
          "en": "dlq"
        },
        "type": "bool",
        "default": true,
        "ui": "switch"
      },
      {
        "name": "sac",
        "alias": {
          "pt": "unico",
          "en": "single"
        },
        "type": "bool",
        "default": false,
        "ui": "switch"
      }
    ]
  },
  "break": {
    "flag": "poisonLoop"
  },
  "data": {
    "sim": {
      "live": true,
