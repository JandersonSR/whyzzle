      "compute": {
        "r": "lookup(lb, algo + '-' + problem + '-' + check, 0)",
        "errPct": "r.errPct",
        "failed": "r.failed",
        "p95": "r.p95",
        "detects": "r.detects",
        "share2": "r.share2",
        "isHot": "r.hotspot",
        "isHole": "r.blackhole",
        "isOver": "r.over"
      },
      "cases": [
        {
          "when": "isHole",
          "flags": [
            "blackhole"
          ]
        },
        {
          "when": "isHot",
          "flags": [
            "hotspot"
          ]
        },
        {
          "when": "isOver",
          "flags": [
            "overload"
          ]
        },
        {
          "when": "detects",
          "flags": [
            "detected"
          ]
        },
        {
          "when": "true",
          "vars": {
            "errPct": "errPct",
            "failed": "failed",
            "p95": "p95",
            "share2": "share2",
            "probTxt": "lookup(probTexts, problem, '')",
            "checkTxt": "lookup(checkTexts, check, '')"
          }
        }
      ],
      "widgets": [
        {
          "type": "metrics",
          "items": [
            {
              "label": "@errM",
              "value": "=errPct",
              "format": "pct",
              "tone": "=errPct >= 5 ? 'bad' : (errPct > 0 ? 'warn' : 'ok')"
            },
            {
              "label": "@failedM",
              "value": "=failed",
              "format": "int",
              "tone": "=failed > 5000 ? 'bad' : (failed > 0 ? 'warn' : 'ok')"
            },
            {
              "label": "@p95M",
              "value": "=p95",
              "format": "ms",
              "tone": "=p95 > 1000 ? 'bad' : (p95 > 300 ? 'warn' : 'ok')"
            },
            {
              "label": "@outM",
              "value": "=detects ? 10 : (problem == 'dead' || problem == 'err500' ? '@never' : '@dash')",
              "tone": "=detects ? 'ok' : (problem == 'dead' || problem == 'err500' ? 'bad' : 'dim')"
            }
          ]
        },
        {
          "type": "table",
          "label": "@tableLabel",
          "columns": [
            "@colServer",
            "@colShare",
            "@colState",
            "p95"
          ],
          "rows": "=r.rows",
          "tones": "=r.tones",
          "caption": "@tableCap"
        },
        {
          "type": "chart",
          "label": "@chartLabel",
          "kind": "bar",
          "labels": [
            "app-1",
            "app-2",
            "app-3"
          ],
          "series": [
            {
              "label": "@series",
              "values": "=r.shares"
            }
          ],
          "max": 100
        },
        {
          "type": "terminal",
          "label": "@termLabel",
          "lines": "=r.term"
        },
        {
          "type": "note",
          "when": "=isHole",
          "tone": "bad",
          "text": "@holeNote"
        },
        {
          "type": "note",
          "when": "=isHole && algo == 'lc'",
          "tone": "warn",
          "text": "@lcHoleNote"
        },
        {
          "type": "note",
          "when": "=isHot",
          "tone": "warn",
          "text": "@hashNote"
        },
        {
          "type": "note",
          "when": "=problem == 'slow' && algo == 'rr'",
          "tone": "warn",
          "text": "@slowRrNote"
        },
        {
          "type": "note",
          "when": "=detects && !isHot",
          "tone": "ok",
          "text": "@detectNote"
        },
        {
          "type": "note",
          "when": "=problem == 'none' && !isHot",
          "tone": "ok",
          "text": "@calmNote"
        }
      ]
    }
  },
  "predict": {
    "options": [
      "zero",
      "few",
      "third"
    ],
    "answer": "few"
  }
}
