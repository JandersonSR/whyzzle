{
  "id": "sd-banco-replica",
  "order": 5,
  "track": "fundamentos",
  "kind": "step",
  "minutes": 20,
  "tags": [
    "banco-de-dados",
    "replicacao",
    "replica-de-leitura",
    "lag",
    "read-your-writes",
    "postgres"
  ],
  "requires": [
    "sd-cache"
  ],
  "executors": [
    "simulado"
  ],
  "model": "declarative",
  "scene": "widgets",
  "command": {
    "verb": {
      "pt": "replicar",
      "en": "replicate"
    },
    "arg": {
      "name": "text",
      "required": false,
      "default": {
        "pt": "secretaria",
        "en": "school-office"
      },
      "ui": "text"
    },
    "flags": [
      {
        "name": "replicas",
        "alias": {
          "pt": "replicas",
          "en": "replicas"
        },
        "type": "int",
        "min": 0,
        "max": 5,
        "default": 2,
        "ui": "slider"
      },
      {
        "name": "lag",
        "alias": {
          "pt": "atraso",
          "en": "lag"
        },
        "type": "int",
        "min": 0,
        "max": 5000,
        "step": 50,
        "default": 500,
        "ui": "slider"
      },
      {
        "name": "rywRead",
        "alias": {
          "pt": "ler-apos-escrita",
          "en": "read-after-write"
        },
        "type": "enum",
        "options": [
          {
            "id": "primary",
            "pt": "primario",
            "en": "primary"
          },
          {
            "id": "replica",
            "pt": "replica",
            "en": "replica"
          }
        ],
        "default": "primary",
        "ui": "select"
      }
    ]
  },
  "break": {
    "flag": "staleRead"
  },
  "data": {
    "sim": {
      "live": true,
      "consts": {
        "reads": 1500,
        "writes": 100,
        "ryw": 100,
        "nodeCap": 1000,
        "svcMs": 5,
        "reloadMs": 300,
        "replRows": [
          " 172.18.0.3  | streaming",
          " 172.18.0.4  | streaming",
          " 172.18.0.5  | streaming",
          " 172.18.0.6  | streaming",
          " 172.18.0.7  | streaming"
        ]
      },
      "compute": {
        "toPrimary": "replicas == 0 ? reads : (rywRead == 'primary' ? ryw : 0)",
        "replicaReads": "reads - toPrimary",
        "perReplica": "replicas == 0 ? 0 : round(replicaReads / replicas)",
        "primaryLoad": "writes + toPrimary",
        "readNode": "replicas == 0 ? primaryLoad : max(perReplica, primaryLoad)",
        "p95Read": "((readNode) / (nodeCap)) >= 0.98 ? 5000 : min(5000, round(3 * svcMs / (1 - ((readNode) / (nodeCap)))))",
        "errPct": "round((1 - min(1, nodeCap / readNode)) * 100, 1)",
        "isStale": "rywRead == 'replica' && replicas > 0 && lag > reloadMs",
        "isFragile": "rywRead == 'replica' && replicas > 0 && lag <= reloadMs",
        "rows": "[[0, round(writes + reads), writes + reads > nodeCap ? '@stOver' : '@stOk'], [1, round(max(writes + (rywRead == 'primary' ? ryw : 0), (reads - (rywRead == 'primary' ? ryw : 0)) / 1)), max(writes + (rywRead == 'primary' ? ryw : 0), (reads - (rywRead == 'primary' ? ryw : 0)) / 1) > nodeCap ? '@stOver' : '@stOk'], [2, round(max(writes + (rywRead == 'primary' ? ryw : 0), (reads - (rywRead == 'primary' ? ryw : 0)) / 2)), max(writes + (rywRead == 'primary' ? ryw : 0), (reads - (rywRead == 'primary' ? ryw : 0)) / 2) > nodeCap ? '@stOver' : '@stOk'], [3, round(max(writes + (rywRead == 'primary' ? ryw : 0), (reads - (rywRead == 'primary' ? ryw : 0)) / 3)), max(writes + (rywRead == 'primary' ? ryw : 0), (reads - (rywRead == 'primary' ? ryw : 0)) / 3) > nodeCap ? '@stOver' : '@stOk']]",
        "tones": "[replicas == 0 ? (writes + reads > nodeCap ? 'bad' : 'info') : 'neutral', replicas == 1 ? (max(writes + (rywRead == 'primary' ? ryw : 0), (reads - (rywRead == 'primary' ? ryw : 0)) / 1) > nodeCap ? 'bad' : 'info') : 'neutral', replicas == 2 ? (max(writes + (rywRead == 'primary' ? ryw : 0), (reads - (rywRead == 'primary' ? ryw : 0)) / 2) > nodeCap ? 'bad' : 'info') : 'neutral', replicas == 3 ? (max(writes + (rywRead == 'primary' ? ryw : 0), (reads - (rywRead == 'primary' ? ryw : 0)) / 3) > nodeCap ? 'bad' : 'info') : 'neutral']",
        "psql": "concat(['$ psql -c \"SELECT client_addr, state FROM pg_stat_replication;\"', ' client_addr |   state', '-------------+-----------'], slice(replRows, 0, replicas), ['(' + replicas + (replicas == 1 ? ' row)' : ' rows)')], [rywRead == 'primary' || replicas == 0 ? '@tPrimary' : (isStale ? '@tStale' : '@tFresh')])"
      },
      "cases": [
        {
          "when": "isStale",
          "flags": [
            "staleRead"
          ]
        },
        {
          "when": "readNode > nodeCap",
          "flags": [
            "overload"
          ]
        },
        {
          "when": "replicas == 0",
          "flags": [
            "noReplica"
          ]
        },
        {
          "when": "isFragile",
          "flags": [
            "fragile"
          ]
        },
        {
          "when": "true",
          "vars": {
            "p95Read": "p95Read",
            "errPct": "errPct",
            "perReplica": "perReplica",
            "primaryLoad": "primaryLoad",
            "readNode": "readNode"
          }
        }
      ],
      "widgets": [
        {
          "type": "metrics",
          "items": [
            {
              "label": "@p95M",
              "value": "=p95Read",
              "format": "ms",
              "tone": "=p95Read > 300 ? 'bad' : 'ok'"
            },
            {
              "label": "@errM",
              "value": "=errPct",
              "format": "pct",
              "tone": "=errPct > 0 ? 'bad' : 'ok'"
            },
            {
              "label": "@busyM",
              "value": "=readNode",
              "format": "int",
              "tone": "=readNode > nodeCap ? 'bad' : (readNode > 800 ? 'warn' : 'ok')"
            },
            {
              "label": "@lagM",
              "value": "=replicas > 0 ? lag : '@dash'",
              "format": "ms",
              "tone": "=isStale ? 'bad' : 'info'"
            }
          ]
        },
        {
          "type": "flow",
          "label": "@flowLabel",
          "steps": [
            {
              "label": "@write",
              "sub": "@writeSub",
              "tone": "info"
            },
            {
              "label": "@primary",
              "sub": "@primarySub",
              "tone": "=primaryLoad > nodeCap ? 'bad' : 'ok'"
            },
            {
              "label": "@replicasL",
              "sub": "=replicas > 0 ? '@replSub' : '@noRepl'",
              "tone": "=replicas == 0 ? 'dim' : (perReplica > nodeCap ? 'bad' : 'ok')"
            },
            {
              "label": "@reread",
              "sub": "=rywRead == 'primary' || replicas == 0 ? '@readPrimary' : '@readReplica'",
              "tone": "=isStale ? 'bad' : (isFragile ? 'warn' : 'ok')"
            }
          ]
        },
        {
          "type": "table",
          "label": "@tableLabel",
          "columns": [
            "@colReplicas",
            "@colBusiest",
            "@colState"
          ],
          "rows": "=rows",
          "tones": "=tones",
          "caption": "@tableCap"
        },
        {
          "type": "terminal",
          "label": "@termLabel",
          "lines": "=psql"
        },
        {
          "type": "note",
          "when": "=isStale",
          "tone": "bad",
          "text": "@staleNote"
        },
        {
          "type": "note",
          "when": "=isFragile",
          "tone": "warn",
          "text": "@fragileNote"
        },
        {
          "type": "note",
          "when": "=readNode > nodeCap",
          "tone": "bad",
          "text": "@overNote"
        },
        {
          "type": "note",
          "when": "=!isStale && !isFragile && readNode <= nodeCap",
          "tone": "ok",
          "text": "@okNote"
        }
      ]
    }
  },
  "predict": {
    "options": [
      "one",
      "two",
      "three"
    ],
    "answer": "two"
  }
}
