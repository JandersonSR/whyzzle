      "compute": {
        "key": "str(qty)",
        "isDouble": "kind == 'double'",
        "isInt": "kind == 'int'",
        "cents": "qty * 10",
        "rightText": "lookup(lang == 'pt' ? dec.pt : dec.en, key, '')",
        "printed": "isDouble ? lookup(lang == 'pt' ? dbl.pt : dbl.en, key, '') : (isInt ? str(cents) : rightText)",
        "exact": "!isDouble || lookup(dblExact, key, false)",
        "intDiv": "floor(cents / 100)",
        "decDivText": "lookup(lang == 'pt' ? decDiv.pt : decDiv.en, key, '')",
        "bytes": "kind == 'decimal' ? 16 : (isDouble ? 8 : 4)",
        "litType": "kind == 'decimal' ? 'decimal total = 0;' : (isDouble ? 'double total = 0;' : 'int totalCentavos = 0;')",
        "litAdd": "kind == 'decimal' ? '    total += 0.10m;' : (isDouble ? '    total += 0.10;' : '    totalCentavos += 10;')"
      },
      "cases": [
        {
          "when": "isDouble && !exact",
          "flags": [
            "moneyDrift"
          ]
        },
        {
          "when": "isDouble && exact",
          "flags": [
            "luckyDouble"
          ]
        },
        {
          "when": "isInt",
          "flags": [
            "inCents"
          ]
        },
        {
          "when": "true",
          "vars": {
            "printed": "printed",
            "right": "rightText",
            "qty": "qty",
            "bytes": "bytes",
            "cents": "cents",
            "intDiv": "intDiv",
            "decDiv": "decDivText"
          }
        }
      ],
      "widgets": [
        {
          "type": "metrics",
          "items": [
            {
              "label": "@printedM",
              "value": "=printed",
              "tone": "=exact ? 'ok' : 'bad'"
            },
            {
              "label": "@rightM",
              "value": "='R$ ' + rightText",
              "tone": "info"
            },
            {
              "label": "@exactM",
              "value": "=exact ? '@yes' : '@no'",
              "tone": "=exact ? 'ok' : 'bad'"
            },
            {
              "label": "@bytesM",
              "value": "=bytes",
              "format": "int",
              "tone": "dim"
            }
          ]
        },
        {
          "type": "terminal",
          "label": "Program.cs",
          "lines": [
            "=litType",
            "='for (int i = 0; i < ' + qty + '; i++)'",
            "{",
            "=litAdd",
            "}",
            "=isInt ? 'Console.WriteLine(totalCentavos);' : 'Console.WriteLine(total);'"
          ]
        },
        {
          "type": "terminal",
          "when": "=isInt",
          "label": "@divLabel",
          "lines": [
            "Console.WriteLine(totalCentavos / 100);",
            "Console.WriteLine(totalCentavos / 100m);"
          ]
        },
        {
          "type": "terminal",
          "label": "@runLabel",
          "lines": "=concat(['$ dotnet run'], [(exact ? '+' : '!') + printed], isInt ? ['?' + intDiv, '+' + decDivText] : [])"
        },
        {
          "type": "table",
          "label": "@tableLabel",
          "columns": [
            "@cType",
            "@cBytes",
            "@cGood",
            "@cTrap"
          ],
          "rows": [
            [
              "int",
              4,
              "@gInt",
              "@tInt"
            ],
            [
              "long",
              8,
              "@gLong",
              "@tLong"
            ],
            [
              "double",
              8,
              "@gDouble",
              "@tDouble"
            ],
            [
              "decimal",
              16,
              "@gDecimal",
              "@tDecimal"
            ],
            [
              "bool",
              1,
              "@gBool",
              "@tBool"
            ],
            [
              "string",
              "@ref",
              "@gString",
              "@tString"
            ]
          ],
          "tones": "=[isInt ? 'info' : 'neutral', 'neutral', isDouble ? (exact ? 'warn' : 'bad') : 'neutral', kind == 'decimal' ? 'ok' : 'neutral', 'neutral', 'neutral']"
        },
        {
          "type": "note",
          "when": "=isDouble && !exact",
          "tone": "bad",
          "text": "@driftNote"
        },
        {
          "type": "note",
          "when": "=isDouble && exact",
          "tone": "warn",
          "text": "@luckyNote"
        },
        {
          "type": "note",
          "when": "=kind == 'decimal'",
          "tone": "ok",
          "text": "@decimalNote"
        },
        {
          "type": "note",
          "when": "=isInt",
          "tone": "info",
          "text": "@intNote"
        }
      ]
    }
